@model IEnumerable<WorldCup2026.Models.Match>

@{
    ViewData["Title"] = "Match Schedule";

    var countryCodes = new Dictionary<string, string> {
        {"Mexico", "mx"}, {"South Africa", "za"}, {"South Korea", "kr"}, {"Czech Republic", "cz"},
        {"Canada", "ca"}, {"Bosnia and Herzegovina", "ba"}, {"Qatar", "qa"}, {"Switzerland", "ch"},
        {"Brazil", "br"}, {"Morocco", "ma"}, {"Haiti", "ht"}, {"Scotland", "gb-sct"},
        {"USA", "us"}, {"Paraguay", "py"}, {"Australia", "au"}, {"Turkey", "tr"},
        {"Germany", "de"}, {"Curacao", "cw"}, {"Ivory Coast", "ci"}, {"Ecuador", "ec"},
        {"Netherlands", "nl"}, {"Japan", "jp"}, {"Sweden", "se"}, {"Tunisia", "tn"},
        {"Spain", "es"}, {"Cape Verde", "cv"}, {"Belgium", "be"}, {"Egypt", "eg"},
        {"Saudi Arabia", "sa"}, {"Uruguay", "uy"}, {"Iran", "ir"}, {"New Zealand", "nz"},
        {"France", "fr"}, {"Senegal", "sn"}, {"Iraq", "iq"}, {"Norway", "no"},
        {"Argentina", "ar"}, {"Algeria", "dz"}, {"Austria", "at"}, {"Jordan", "jo"},
        {"Portugal", "pt"}, {"DR Congo", "cd"}, {"Uzbekistan", "uz"}, {"Colombia", "co"},
        {"England", "gb-eng"}, {"Croatia", "hr"}, {"Ghana", "gh"}, {"Panama", "pa"}
    };

    var groupColors = new Dictionary<string, string>
    {
        {"A", "#6A0dad"}, {"B", "#0052B4"}, {"C", "#00B2A9"}, {"D", "#FF4500"},
        {"E", "#007A33"}, {"F", "#E10600"}, {"G", "#9EFD38"}, {"H", "#FF1493"},
        {"I", "#38B6FF"}, {"J", "#8B0000"}, {"K", "#FFA07A"}, {"L", "#111111"}
    };

    string GetFlagUrl(string countryName) => countryCodes.ContainsKey(countryName) ? $"https://flagcdn.com/w40/{countryCodes[countryName]}.png" : "https://placehold.co/40x30?text=⚽";
    string GetGroupColor(string groupLetter) => (groupLetter != null && groupColors.ContainsKey(groupLetter)) ? groupColors[groupLetter] : "#6c757d";
    
    // Helper за имената на фазите
    string GetPhaseLabel(int id, string groupLetter) {
        if (id <= 72) return "Group " + (groupLetter ?? "-");
        if (id >= 73 && id <= 88) return "Round of 32";
        if (id >= 89 && id <= 96) return "Round of 16";
        if (id >= 97 && id <= 100) return "Quarter-Final";
        if (id >= 101 && id <= 102) return "Semi-Final";
        if (id == 103) return "3rd Place Play-off";
        if (id == 104) return "Final";
        return "Knockout";
    }
    
    bool isAdmin = User.IsInRole("Admin");
    int index = 0;
    var sortedMatches = Model.OrderBy(m => m.Id).ToList();
}

<div class="container mt-4">
    <h1 class="text-center mb-5 fw-bold" style="color: #0052B4; font-family: 'Chreed-ExtraBold', sans-serif;">Tournament Matches</h1>

    @if (TempData["Error"] != null) { <div class="alert alert-danger shadow-sm">@TempData["Error"]</div> }
    @if (TempData["Success"] != null) { <div class="alert alert-success shadow-sm">@TempData["Success"]</div> }

    <form asp-action="SaveAll" method="post">
        @if (isAdmin)
        {
            <div class="mb-4 text-end sticky-top bg-light p-2" style="z-index: 10;">
                <button type="submit" class="btn btn-primary shadow-sm fw-bold px-4 py-2">💾 Save All Scores</button>
            </div>
        }

        <div class="row">
            @foreach (var match in sortedMatches)
            {
                @if (match.Id == 73) { <div class="w-100 text-center mt-5 mb-4"><h2 class="fw-bold" style="color: #0052B4; font-family: 'Chreed-ExtraBold', sans-serif;">ROUND OF 32</h2></div> }
                @if (match.Id == 89) { <div class="w-100 text-center mt-5 mb-4"><h2 class="fw-bold" style="color: #0052B4; font-family: 'Chreed-ExtraBold', sans-serif;">ROUND OF 16</h2></div> }
                @if (match.Id == 97) { <div class="w-100 text-center mt-5 mb-4"><h2 class="fw-bold" style="color: #0052B4; font-family: 'Chreed-ExtraBold', sans-serif;">QUARTER-FINALS</h2></div> }
                @if (match.Id == 101) { <div class="w-100 text-center mt-5 mb-4"><h2 class="fw-bold" style="color: #0052B4; font-family: 'Chreed-ExtraBold', sans-serif;">SEMI-FINALS</h2></div> }
                @if (match.Id == 103) { <div class="w-100 text-center mt-5 mb-4"><h2 class="fw-bold" style="color: #0052B4; font-family: 'Chreed-ExtraBold', sans-serif;">FINALS</h2></div> }

                <input type="hidden" name="updates[@index].MatchId" value="@match.Id" />

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 bg-white rounded-3 overflow-hidden">
                        <div class="card-header border-0 px-3 py-2 fw-bold text-white" style="background-color: @(match.Id <= 72 ? GetGroupColor(match.HomeTeam?.GroupLetter) : "#6c757d");">
                            @GetPhaseLabel(match.Id, match.HomeTeam?.GroupLetter)
                            <span class="float-end">@match.KickOffTime.ToString("HH:mm")</span>
                        </div>
                        <div class="card-body p-3 text-center">
                            <div class="d-flex justify-content-between align-items-center my-2">
                                <div class="d-flex align-items-center"><img src="@GetFlagUrl(match.HomeTeam?.Name)" class="rounded shadow-sm me-3" style="width: 38px; height: 26px; object-fit: cover;"/><span class="fw-semibold">@match.HomeTeam?.Name</span></div>
                                <input type="number" name="updates[@index].HomeScore" value="@match.HomeScore" class="form-control text-center" style="width: 55px;" min="0" @(isAdmin ? "" : "disabled") />
                            </div>
                            <div class="d-flex justify-content-between align-items-center my-2">
                                <div class="d-flex align-items-center"><img src="@GetFlagUrl(match.AwayTeam?.Name)" class="rounded shadow-sm me-3" style="width: 38px; height: 26px; object-fit: cover;"/><span class="fw-semibold">@match.AwayTeam?.Name</span></div>
                                <input type="number" name="updates[@index].AwayScore" value="@match.AwayScore" class="form-control text-center" style="width: 55px;" min="0" @(isAdmin ? "" : "disabled") />
                            </div>
                            <div class="text-muted small mt-2">Status: @match.Status</div>
                        </div>
                    </div>
                </div>

                @if (isAdmin)
                {
                    @if (match.Id == 72) { <div class="w-100 text-center mb-5"><form asp-action="EndGroupPhase" method="post"><button type="submit" class="btn btn-warning fw-bold px-4">End League Phase</button></form></div> }
                    @if (match.Id == 88) { <div class="w-100 text-center mb-5"><form asp-action="EndRO32" method="post"><button type="submit" class="btn btn-warning fw-bold px-4">End RO32</button></form></div> }
                    @if (match.Id == 96) { <div class="w-100 text-center mb-5"><form asp-action="EndRO16" method="post"><button type="submit" class="btn btn-warning fw-bold px-4">End RO16</button></form></div> }
                    @if (match.Id == 100) { <div class="w-100 text-center mb-5"><form asp-action="EndQuarterFinals" method="post"><button type="submit" class="btn btn-warning fw-bold px-4">End QF</button></form></div> }
                    @if (match.Id == 102) { <div class="w-100 text-center mb-5"><form asp-action="EndSemiFinals" method="post"><button type="submit" class="btn btn-warning fw-bold px-4">End Semi-Finals</button></form></div> }
                    @if (match.Id == 104) { <div class="w-100 text-center mb-5"><form asp-action="EndFinals" method="post"><button type="submit" class="btn btn-success fw-bold px-4 shadow">END TOURNAMENT & SHOW PODIUM</button></form></div> }
                }
                index++;
            }
        </div>
    </form>
</div>