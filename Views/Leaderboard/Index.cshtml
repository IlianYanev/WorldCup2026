@model WorldCup2026.Models.LeaderboardViewModel

<div class="container mt-5">
    <h1 class="text-center fw-bold mb-4" style="color: #0052B4;">🏆 Leaderboard 🏆</h1>

    <div class="card shadow-sm border-0">
        <table class="table table-hover mb-0">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th class="text-center">Group Points</th>
                    <th class="text-center">Podium Points</th>
                    <th class="text-center">Total Points</th>
                </tr>
            </thead>
            <tbody>
                @{ int rank = 1; }
                @foreach (var userScore in Model.UserScores)
                {
                    <tr>
                        <td class="fw-bold">@rank</td>
                        <td>@userScore.Username</td>
                        <td class="text-center">@userScore.GroupPoints</td>
                        <td class="text-center">@userScore.PodiumPoints</td>
                        <td class="text-center fw-bold text-primary">@userScore.TotalPoints</td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>